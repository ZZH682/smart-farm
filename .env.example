# ============================================================
# 环境变量模板 —— 复制本文件为 .env 后填写真实值
#   copy .env.example .env
# .env 已被 .gitignore 排除，不会随源码提交；严禁把真实密钥写进代码
# ============================================================

# ---- MQTT Broker（默认自动检测本机 IP，可覆盖）----
# MQTT_BROKER=127.0.0.1
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# ---- 企业微信/飞书/钉钉/Server酱 告警推送 webhook ----
# 留空 = 不推送
# NOTIFY_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=你的key
# NOTIFY_WEBHOOK_TYPE=auto

# ---- 大模型 API（OpenAI 兼容 /chat/completions）----
# 留空 = 使用内置规则引擎
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash

# ---- Web 控制接口鉴权令牌（留空则启动时自动生成随机令牌并打印）----
# WEB_TOKEN=请设置一个足够随机的字符串

# ---- 数据保留天数（超过自动清理）----
# DATA_RETENTION_DAYS=90

# ---- 传感器采样间隔（秒）----
# SENSOR_INTERVAL=5

# ---- 自动控制最小动作间隔（秒）----
# CONTROL_MIN_ACTION_INTERVAL=60
